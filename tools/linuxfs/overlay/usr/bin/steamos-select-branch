#!/bin/sh
# The SteamOS update-branch selector the client calls in Deck mode.
# The session forces the client branch on the command line and keeps package/beta in step with it, so a selection here would only start the restart loop bannerlator-session describes.
# It lists and reports the stable branch, and accepts and ignores a choice.
# Staged from the apk. (From The412Banner/SteamDeck.)
case "${1:-}" in
  -l) printf 'rel\n' ;;
  -c) printf 'rel\n' ;;
  *) : ;;
esac
exit 0
